

Jenkinsfile


pipeline {
    agent any
    
    environment {
        KUBE_CREDENTIAL_ID = 'k8s'
    }
    
    stages{
        stage('version'){
            steps{
                withKubeConfig([credentialsId: "${KUBE_CREDENTIAL_ID}"]) {
                sh '''
                kubectl version --client -o yaml
                sleep 5
                cd /var/lib/jenkins/sso/
                kubectl create -f sso.yaml
                kubectl get pods --watch
                sleep 1m
                kubectl get deploy
                kubectl get service
                kubectl get pods
                '''
            }
            }
        }
    }
}









